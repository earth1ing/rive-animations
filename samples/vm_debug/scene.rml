<Rive version="1" kind="fragment">
    <!-- One scripted layout fills the artboard and draws from the Dashboard
         view model. The background reads the Theme global through a bind, so
         a global edited in the debugger shows without any script. A click
         anywhere writes title from a listener, with no script involved, for
         a data breakpoint to stop natively on. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" viewModelInstanceId="0:41" clip="true" width="600" height="400" styleId="0:5" name="Main" id="0:2">
        <Fill name="Background">
            <SolidColor colorValue="FF101418" name="Color">
                <DataBindContext sourcePathIds="0:90-0:91" propertyKey="37"/>
            </SolidColor>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Shape x="300" y="200" name="Backdrop" id="0:20">
            <Rectangle width="600" height="400" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="00000000" name="Color"/></Fill>
        </Shape>
        <LayoutComponent width="600" height="400" styleId="0:11" name="Root Layout" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Layout Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:80" name="Orbit" id="0:12"/>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState/>
            </StateMachineLayer>
            <StateMachineListenerSingle targetId="0:20" listenerTypeValue="click" name="Tap" id="0:21">
                <ListenerViewModelChange>
                    <BindablePropertyString propertyValue="tapped">
                        <DataBindContext sourcePathIds="0:40-0:46" propertyKey="635" direction="true"/>
                    </BindablePropertyString>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
        </StateMachine>
    </Artboard>

    <DataEnumCustom name="Shape" id="0:70">
        <DataEnumValue key="circle" value="Circle" id="0:71"/>
        <DataEnumValue key="square" value="Square" id="0:72"/>
        <DataEnumValue key="diamond" value="Diamond" id="0:73"/>
    </DataEnumCustom>

    <!-- Written by the script every frame. -->
    <ViewModel defaultInstanceId="0:61" name="Stats" id="0:60">
        <ViewModelPropertyNumber name="frames" id="0:62"/>
        <ViewModelPropertyNumber name="angle" id="0:63"/>
        <ViewModelPropertyNumber name="bursts" id="0:64"/>
        <ViewModelInstance exports="true" name="Live" id="0:61">
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:62"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:63"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:64"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- One row per orb on the ring. -->
    <ViewModel defaultInstanceId="0:51" name="Orb" id="0:50">
        <ViewModelPropertyNumber name="size" id="0:52"/>
        <ViewModelPropertyColor name="color" id="0:53"/>
        <ViewModelInstance exports="true" name="Red" id="0:51">
            <ViewModelInstanceNumber propertyValue="18" viewModelPropertyId="0:52"/>
            <ViewModelInstanceColor propertyValue="FFE5484D" viewModelPropertyId="0:53"/>
        </ViewModelInstance>
        <ViewModelInstance exports="true" name="Amber" id="0:54">
            <ViewModelInstanceNumber propertyValue="12" viewModelPropertyId="0:52"/>
            <ViewModelInstanceColor propertyValue="FFFFB224" viewModelPropertyId="0:53"/>
        </ViewModelInstance>
        <ViewModelInstance exports="true" name="Teal" id="0:55">
            <ViewModelInstanceNumber propertyValue="24" viewModelPropertyId="0:52"/>
            <ViewModelInstanceColor propertyValue="FF12A594" viewModelPropertyId="0:53"/>
        </ViewModelInstance>
    </ViewModel>

    <ViewModel defaultInstanceId="0:41" name="Dashboard" id="0:40">
        <ViewModelPropertyNumber name="speed" id="0:42"/>
        <ViewModelPropertyBoolean name="paused" id="0:43"/>
        <ViewModelPropertyColor name="tint" id="0:44"/>
        <ViewModelPropertyEnumCustom enumId="0:70" name="shape" id="0:45"/>
        <ViewModelPropertyString name="title" id="0:46"/>
        <ViewModelPropertyTrigger name="burst" id="0:47"/>
        <ViewModelPropertyViewModel viewModelReferenceId="0:60" name="stats" id="0:48"/>
        <ViewModelPropertyList name="orbs" id="0:49"/>
        <ViewModelInstance exports="true" name="Instance" id="0:41">
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:42"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:43"/>
            <ViewModelInstanceColor propertyValue="FF7C66DC" viewModelPropertyId="0:44"/>
            <ViewModelInstanceEnum propertyValue="0:71" viewModelPropertyId="0:45"/>
            <ViewModelInstanceString propertyValue="hello" viewModelPropertyId="0:46"/>
            <ViewModelInstanceTrigger viewModelPropertyId="0:47"/>
            <ViewModelInstanceViewModel propertyValue="0:61" viewModelPropertyId="0:48"/>
            <ViewModelInstanceList viewModelPropertyId="0:49">
                <ViewModelInstanceListItem viewModelId="0:50" viewModelInstanceId="0:51"/>
                <ViewModelInstanceListItem viewModelId="0:50" viewModelInstanceId="0:54"/>
                <ViewModelInstanceListItem viewModelId="0:50" viewModelInstanceId="0:55"/>
            </ViewModelInstanceList>
        </ViewModelInstance>
    </ViewModel>

    <ViewModel viewModelType="global" defaultInstanceId="0:92" name="Theme" id="0:90">
        <ViewModelPropertyColor name="background" id="0:91"/>
        <ViewModelInstance exports="true" name="Default" id="0:92">
            <ViewModelInstanceColor propertyValue="FF101418" viewModelPropertyId="0:91"/>
        </ViewModelInstance>
    </ViewModel>

    <!-- The script asset 0:80 is declared in luau/script.rml or
         as/script.rml, whichever rive.yaml leaves in. -->
</Rive>
