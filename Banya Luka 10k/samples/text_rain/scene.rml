<Rive version="1" kind="fragment">
    <!-- The rain is a scripted layout filling the artboard. It takes the
         Umbrella artboard as an input so the script can carry it, open it and
         read its canopy back. -->
    <Artboard defaultStateMachineId="0:7" clip="true" width="1000" height="700" styleId="0:5" name="Main" id="0:2">
        <Fill name="Background">
            <SolidColor colorValue="FF050810" name="Color"/>
        </Fill>
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <LayoutComponent width="1000" height="700" styleId="0:11" name="Root Layout" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="1" layoutHeightScaleType="1" widthUnitsValue="3" heightUnitsValue="3" name="Layout Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:80" name="Rain" id="0:12">
                <ScriptInputArtboard artboardId="0:30" name="umbrella" id="0:13"/>
            </ScriptedLayout>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- The umbrella is artist content. Its state machine opens and closes
         the canopy from the `open` view model property; the script only flips
         that property and reads the canopy's scale back to size the shelter.
         The Rig node sits at (100, 60), the point the script carries; it is not
         named after the artboard, or node() would hand the artboard back. -->
    <Artboard defaultStateMachineId="0:37" viewModelId="0:50" viewModelInstanceId="0:51" width="200" height="160" styleId="0:35" name="Umbrella" id="0:30">
        <LayoutComponentStyle name="Umbrella Style" id="0:35"/>
        <Node x="100" y="60" name="Rig" id="0:40">
            <Node name="Canopy" id="0:41">
                <Shape y="-47" name="Ferrule" id="0:47">
                    <Rectangle width="4" height="12" cornerRadiusTL="2" cornerRadiusTR="2" cornerRadiusBL="2" cornerRadiusBR="2" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFB9BFC9" name="Color"/>
                    </Fill>
                </Shape>
                <Shape name="Ribs" id="0:48">
                    <PointsPath name="Left">
                        <StraightVertex x="0" y="-39"/>
                        <CubicMirroredVertex x="-12" y="-16" rotation="-1.0" distance="10"/>
                        <StraightVertex x="-21.67" y="0"/>
                    </PointsPath>
                    <PointsPath name="Right">
                        <StraightVertex x="0" y="-39"/>
                        <CubicMirroredVertex x="12" y="-16" rotation="1.0" distance="10"/>
                        <StraightVertex x="21.67" y="0"/>
                    </PointsPath>
                    <Stroke thickness="1.2" cap="round" name="Stroke">
                        <SolidColor colorValue="FFC2C8D2" name="Color"/>
                    </Stroke>
                </Shape>
                <Shape name="Dome" id="0:42">
                    <PointsPath isClosed="true" name="Path">
                        <CubicDetachedVertex x="-65" y="11.38" inRotation="-1.7373" inDistance="39.22" outRotation="0.4834" outDistance="16.31"/>
                        <CubicDetachedVertex x="-21.67" y="0" inRotation="2.3318" inDistance="20.94" outRotation="0.8098" outDistance="20.94"/>
                        <CubicDetachedVertex x="21.67" y="0" inRotation="2.3318" inDistance="20.94" outRotation="0.8098" outDistance="20.94"/>
                        <CubicDetachedVertex x="65" y="11.38" inRotation="2.6581" inDistance="16.31" outRotation="-1.4043" outDistance="39.22"/>
                        <CubicDetachedVertex x="0" y="-39" inRotation="-0.4636" inDistance="21.8" outRotation="-2.6779" outDistance="21.8"/>
                    </PointsPath>
                    <Fill name="Fill">
                        <LinearGradient startX="-20" startY="-46" endX="20" endY="14" name="Gradient">
                            <GradientStop colorValue="FFFFFFFF" position="0"/>
                            <GradientStop colorValue="FFE9ECF1" position="0.55"/>
                            <GradientStop colorValue="FFC3CAD5" position="1"/>
                        </LinearGradient>
                    </Fill>
                    <Stroke thickness="1.5" join="round" name="Stroke">
                        <SolidColor colorValue="FFFFFFFF" name="Color"/>
                    </Stroke>
                </Shape>
                <Shape y="5" name="Underside" id="0:49">
                    <PointsPath isClosed="true" name="Path">
                        <CubicDetachedVertex x="-65" y="11.38" inRotation="-1.7373" inDistance="39.22" outRotation="0.4834" outDistance="16.31"/>
                        <CubicDetachedVertex x="-21.67" y="0" inRotation="2.3318" inDistance="20.94" outRotation="0.8098" outDistance="20.94"/>
                        <CubicDetachedVertex x="21.67" y="0" inRotation="2.3318" inDistance="20.94" outRotation="0.8098" outDistance="20.94"/>
                        <CubicDetachedVertex x="65" y="11.38" inRotation="2.6581" inDistance="16.31" outRotation="-1.4043" outDistance="39.22"/>
                        <CubicDetachedVertex x="0" y="-39" inRotation="-0.4636" inDistance="21.8" outRotation="-2.6779" outDistance="21.8"/>
                    </PointsPath>
                    <Fill name="Fill">
                        <SolidColor colorValue="FF6B7386" name="Color"/>
                    </Fill>
                </Shape>
            </Node>
            <Shape name="Shaft" id="0:44">
                <PointsPath name="Path">
                    <StraightVertex x="0" y="-39"/>
                    <StraightVertex x="0" y="62"/>
                </PointsPath>
                <Stroke thickness="3" cap="round" name="Stroke">
                    <SolidColor colorValue="FFB4BAC4" name="Color"/>
                </Stroke>
            </Shape>
            <Shape name="Handle" id="0:53">
                <PointsPath name="Path">
                    <StraightVertex x="0" y="60"/>
                    <CubicDetachedVertex x="0" y="80" inRotation="-1.5708" inDistance="0" outRotation="1.5708" outDistance="6.63"/>
                    <CubicDetachedVertex x="-12" y="92" inRotation="0" inDistance="6.63" outRotation="3.1416" outDistance="6.63"/>
                    <CubicDetachedVertex x="-24" y="80" inRotation="1.5708" inDistance="6.63" outRotation="-1.5708" outDistance="0"/>
                </PointsPath>
                <Stroke thickness="4.5" cap="round" join="round" name="Stroke">
                    <SolidColor colorValue="FF8B5E3C" name="Color"/>
                </Stroke>
            </Shape>
        </Node>

        <StateMachine name="State Machine 1" id="0:37">
            <StateMachineLayer name="Canopy" id="0:38">
                <AnyState x="400" y="-120"/>
                <ExitState x="600" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:60"/>
                </EntryState>
                <AnimationState x="160" y="0" animationId="0:45" id="0:60">
                    <StateTransition stateToId="0:61" duration="450" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.6" y1="0" x2="0.3" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="360" y="0" animationId="0:46" id="0:61">
                    <StateTransition stateToId="0:60" duration="450" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.3" y1="0" x2="0.2" y2="1.2"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:50-0:52" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Two held poses; the transitions above blend between them. -->
        <LinearAnimation duration="1" name="Open" id="0:45">
            <KeyedObject objectId="0:41">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="1" name="Closed" id="0:46">
            <KeyedObject objectId="0:41">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.12" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.3" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <ViewModel defaultInstanceId="0:51" name="Umbrella" id="0:50">
        <ViewModelPropertyBoolean name="open" id="0:52"/>
        <ViewModelInstance exports="true" name="Instance" id="0:51">
            <ViewModelInstanceBoolean propertyValue="true" viewModelPropertyId="0:52"/>
        </ViewModelInstance>
    </ViewModel>

    <ScriptAsset file="main.luau" name="main" id="0:80"/>
    <FontAsset file="JetBrainsMono.ttf" name="JetBrainsMono" id="0:90"/>
</Rive>
